# name: luajit typed UDF calls
# description: Test luajit_i() and luajit_f() with compiled UDFs
# group: [luajit]

# compile add
statement ok
SELECT ok FROM luajit_module(
    mode := 'compile',
    source := 'return function(a, b) return a + b end',
    sql_name := 'add'
);

# compile sq
statement ok
SELECT ok FROM luajit_module(
    mode := 'compile',
    source := 'return function(x) return x * x end',
    sql_name := 'sq'
);

# luajit_i — typed BIGINT (2 args)
query I
SELECT luajit_i('add', 3, 4)
----
7

# luajit_i — single arg
query I
SELECT luajit_i('sq', 5)
----
25
